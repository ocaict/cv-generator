<!-- views/portfolio/hire-modal-component.ejs -->
<div id="hire-modal" class="fixed inset-0 z-[60] hidden">
    <div id="hire-backdrop" class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-300 opacity-0"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4">
        <div id="hire-content" class="bg-white dark:bg-slate-900 w-full max-w-md rounded-[2.5rem] shadow-2xl transition-all duration-300 scale-95 opacity-0 overflow-hidden border border-white/20">
            <!-- Modal Header -->
            <div class="px-8 pt-8 pb-6 bg-gradient-to-br from-indigo-500 to-indigo-600 text-white relative">
                <button onclick="closeHire()" id="hire-close" class="absolute top-6 right-6 w-8 h-8 flex items-center justify-center bg-white/10 hover:bg-white/20 rounded-full transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
                <div class="w-12 h-12 bg-white/20 backdrop-blur-md rounded-2xl flex items-center justify-center mb-4">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                </div>
                <h3 class="text-xl font-black uppercase tracking-tight leading-none mb-1">Contact <%= portfolioUser.name || 'Expert' %></h3>
                <p class="text-white/80 text-[10px] font-bold uppercase tracking-widest">Global Talent Reach-out</p>
            </div>

            <!-- Form -->
            <form id="hire-form" class="p-8 space-y-4">
                <div class="grid grid-cols-1 gap-4">
                    <div>
                        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Your Name</label>
                        <input type="text" name="name" required placeholder="John Recruiter" class="w-full px-5 py-3 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm font-medium transition-all">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Company</label>
                        <input type="text" name="company" placeholder="Tech Innovations Ltd." class="w-full px-5 py-3 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm font-medium transition-all">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Email Address</label>
                        <input type="email" name="email" required placeholder="recruiter@company.com" class="w-full px-5 py-3 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm font-medium transition-all">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1.5 ml-1">Message</label>
                        <textarea name="message" rows="3" placeholder="Hi, I'm interested in your professional portfolio..." class="w-full px-5 py-3 bg-gray-50 border border-gray-100 rounded-2xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm font-medium transition-all resize-none"></textarea>
                    </div>
                </div>

                <button type="submit" id="hire-submit" class="w-full bg-slate-900 hover:bg-black text-white px-8 py-4 rounded-2xl font-black uppercase tracking-widest shadow-xl transition-all flex items-center justify-center space-x-3 group">
                    <span>Send Reach-out</span>
                    <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </button>
            </form>

            <!-- Success State -->
            <div id="hire-success" class="hidden p-12 text-center space-y-6">
                <div class="w-20 h-20 bg-indigo-100 rounded-[2rem] flex items-center justify-center mx-auto text-indigo-600 animate-bounce">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <div>
                    <h4 class="text-xl font-black text-slate-900 uppercase tracking-tight">Message Sent!</h4>
                    <p class="text-sm text-slate-500 font-medium">Notification has been pushed to the talent's dashboard.</p>
                </div>
                <button onclick="closeHire()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-4 rounded-2xl font-black uppercase tracking-widest transition-all">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    function closeHire() {
        document.getElementById('hire-backdrop').classList.remove('opacity-100');
        document.getElementById('hire-content').classList.remove('scale-100', 'opacity-100');
        document.getElementById('hire-content').classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            document.getElementById('hire-modal').classList.add('hidden');
            document.getElementById('hire-form').classList.remove('hidden');
            document.getElementById('hire-success').classList.add('hidden');
            document.body.style.overflow = '';
        }, 300);
    }

    document.getElementById('hire-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById('hire-submit');
        const originalText = submitBtn.innerHTML;
        
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="animate-pulse">Pushing...</span>';

        const formData = new FormData(e.target);
        const payload = Object.fromEntries(formData.entries());

        try {
            // Send to a portfolio-level endpoint or the global leads endpoint
            // Note: Since this is global, we might need a specific "Portfolio Lead" relation or just use the user's primary/first public CV
            const res = await fetch(`/api/user-leads/<%= portfolioUser.id %>`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                document.getElementById('hire-form').classList.add('hidden');
                document.getElementById('hire-success').classList.remove('hidden');
            } else {
                throw new Error('Failed to send');
            }
        } catch (err) {
            alert('Oops! Delivery failed. Please try again or check connection.');
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalText;
        }
    });

    document.getElementById('hire-backdrop').addEventListener('click', closeHire);
</script>
