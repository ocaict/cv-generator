<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> — OcaTech Talent</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;900&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .font-outfit { font-family: 'Outfit', sans-serif; }
        .glass-header { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }
        .animate-fade-in { animation: fadeIn 0.8s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .cv-card:hover { transform: translateY(-8px); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1); }
    </style>
</head>
<body class="bg-gray-50 text-slate-900 border-t-4 border-indigo-600">
    <!-- Navigation / Header -->
    <header class="glass-header sticky top-0 z-40 border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <a href="/" class="flex items-center space-x-2">
                <span class="w-8 h-8 bg-indigo-600 rounded-xl flex items-center justify-center text-white font-black text-lg">O</span>
                <span class="text-sm font-black uppercase tracking-tighter text-slate-900 dark:text-white">CV Generator <span class="text-indigo-600">Talent</span></span>
            </a>
            
            <a href="/auth/register" class="text-[10px] font-black uppercase tracking-widest text-indigo-600 border-2 border-indigo-50 px-5 py-2.5 rounded-xl hover:bg-indigo-600 hover:text-white transition-all shadow-sm">
                Create Your Own Portfolio
            </a>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-16">
        <!-- Professional Talent Profile Header -->
        <div class="mb-16 animate-fade-in">
            <div class="flex flex-col md:flex-row items-center md:items-end justify-between gap-8 bg-white p-10 md:p-16 rounded-[3rem] shadow-sm border border-gray-100 relative overflow-hidden group">
                <!-- Abstract Design Elements -->
                <div class="absolute -right-20 -top-20 w-64 h-64 bg-indigo-50 rounded-full opacity-50 group-hover:scale-110 transition-transform duration-1000"></div>
                <div class="absolute -left-10 -bottom-10 w-40 h-40 bg-emerald-50 rounded-full opacity-50"></div>

                <div class="relative z-10 text-center md:text-left">
                    <div class="flex items-center justify-center md:justify-start space-x-3 mb-6">
                        <span class="px-4 py-1.5 bg-indigo-600 text-white text-[10px] font-black uppercase tracking-widest rounded-full shadow-lg shadow-indigo-100 uppercase">Available for Hire</span>
                        <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-ping"></span>
                    </div>
                    <h1 class="text-5xl md:text-7xl font-black font-outfit text-slate-900 tracking-tighter leading-none mb-6">
                        <%= portfolioUser.displayName %>
                    </h1>
                    <p class="text-lg md:text-xl text-slate-500 font-medium max-w-2xl leading-relaxed">
                        Professional Portfolio & Expertise Collection. Explore my specialized career tracks and impact-driven outcomes below.
                    </p>
                </div>

                <div class="relative z-10 flex flex-col items-center">
                    <button onclick="openHire()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-10 py-5 rounded-[2rem] font-black uppercase tracking-widest shadow-2xl shadow-indigo-100 hover:scale-105 active:scale-95 transition-all flex items-center space-x-3 mb-4">
                        <span>Contact Talent</span>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    </button>
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest text-center">Inquiry will be logged instantly in the candidate's CRM.</p>
                </div>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4 px-4">
            <h2 class="text-xs font-black text-slate-400 uppercase tracking-[0.3em] flex items-center">
                Career Specializations
            </h2>
            <div class="flex-grow h-px hidden sm:block mx-6 bg-gray-200"></div>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">
                <%= cvs.length %> Specialized Personas
            </p>
        </div>

        <!-- Career Persona Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            <% cvs.forEach(cv => { %>
                <div class="cv-card group relative bg-white rounded-[2.5rem] border border-gray-100 shadow-sm transition-all duration-500 overflow-hidden flex flex-col cursor-pointer" onclick="window.location.href='/p/<%= cv.publicSlug %>'">
                    <!-- Mini-Preview -->
                    <div class="aspect-[4/3] bg-gray-50 relative overflow-hidden flex items-center justify-center p-6 border-b border-gray-50">
                        <img src="/images/template_<%= cv.templateId %>.png" class="w-full h-full object-contain transform group-hover:scale-110 transition-transform duration-700 shadow-xl rounded-md origin-bottom" alt="Preview">
                        
                        <div class="absolute inset-0 bg-indigo-900/0 group-hover:bg-indigo-900/40 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
                             <span class="px-6 py-3 bg-white text-indigo-600 rounded-2xl font-black text-xs uppercase tracking-widest shadow-2xl">Explore Track</span>
                        </div>
                    </div>

                    <div class="p-8 flex-grow flex flex-col">
                        <div class="flex items-start justify-between mb-2">
                            <h3 class="text-xl font-black text-slate-900 leading-tight transition-colors uppercase tracking-tight truncate mr-4"><%= cv.title %></h3>
                            <span class="text-[9px] font-black text-slate-300 uppercase tracking-widest border border-gray-100 px-2 py-1 rounded-lg"><%= cv.templateId %></span>
                        </div>
                        <p class="text-[10px] text-slate-400 font-bold mb-6 uppercase tracking-widest flex items-center">
                            Last Updated <%= cv.relativeTime %>
                        </p>

                        <!-- Strength Gauge -->
                        <div class="mt-auto">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest flex items-center">
                                    Profile Strength
                                </span>
                                <span class="text-[10px] font-black <%= cv.strengthScore > 80 ? 'text-emerald-500' : 'text-indigo-600' %> uppercase tracking-widest">
                                    <%= cv.strengthScore %>%
                                </span>
                            </div>
                            <div class="h-1.5 w-full bg-gray-50 rounded-full overflow-hidden p-0.5 shadow-inner">
                                <div class="h-full bg-gradient-to-r <%= cv.strengthScore > 80 ? 'from-green-400 to-green-500' : 'from-indigo-500 to-indigo-600' %> rounded-full transition-all duration-1000 ease-out" style="width: <%= cv.strengthScore %>%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </main>

    <!-- Hire Modal Inclusion (Reusable) -->
    <%- include('hire-modal-component', { portfolioUser: portfolioUser }) %>

    <footer class="max-w-7xl mx-auto px-6 py-20 border-t border-gray-100 text-center">
        <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.3em] mb-4">Powered by OcaTech Professional Intelligence</p>
        <p class="text-[9px] font-bold text-slate-300 uppercase tracking-[0.3em]">© <%= new Date().getFullYear() %> Talent Portfolio Engine</p>
    </footer>

    <script>
        function openHire() {
            document.getElementById('hire-modal').classList.remove('hidden');
            setTimeout(() => {
                document.getElementById('hire-backdrop').classList.add('opacity-100');
                document.getElementById('hire-content').classList.remove('scale-95', 'opacity-0');
                document.getElementById('hire-content').classList.add('scale-100', 'opacity-100');
            }, 10);
            document.body.style.overflow = 'hidden';
        }
    </script>
</body>
</html>
